<mxCell id="c73" value="ESP32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;fontStyle=1;align=right;" vertex="1" parent="1"><mxGeometry x="317.0" y="1056.0" width="60.0" height="20.0" as="geometry" /></mxCell>
<mxCell id="c74" value="dobradiça: a tampa fecha pelo próprio peso" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="944.0" width="190.0" height="44.0" as="geometry" /></mxCell>
<mxCell id="c75" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#004D7B;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200.0" y="964.0" as="sourcePoint" /><mxPoint x="246.0" y="982.0" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="c76" value="tampa levantada: abre por baixo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="1154.0" width="226.0" height="22.0" as="geometry" /></mxCell>
<mxCell id="c77" value="frente: a tampa, de papelão com cerca de 2 mm (medida em 05/10), dentro do limite de 2 a 3 mm do leitor; sem metal por perto" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="1188.0" width="216.0" height="84.0" as="geometry" /></mxCell>
<mxCell id="c78" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#004D7B;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="228.0" y="1198.0" as="sourcePoint" /><mxPoint x="248.0" y="1198.0" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="c79" value="aba de 4,5 cm, por fora da parede de baixo, sem corte" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="1272.0" width="216.0" height="44.0" as="geometry" /></mxCell>
<mxCell id="c80" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#004D7B;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="228.0" y="1282.0" as="sourcePoint" /><mxPoint x="270.0" y="1242.0" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="c81" value="fundo: a porca e a ponta dos parafusos do ESP32 saem por fora; na mesa por enquanto, e na parede em 27/10 (data provisória), com calços de papelão nas quinas de fora e a fita dupla-face neles" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="430.0" y="1000.0" width="310.0" height="64.0" as="geometry" /></mxCell>
<mxCell id="c82" value="furo do cabo: na parede de baixo, a mais de 5,5 cm da tampa, atrás da protoboard e fora da aba" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="430.0" y="1252.0" width="300.0" height="64.0" as="geometry" /></mxCell>
<mxCell id="c83" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#004D7B;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="426.0" y="1262.0" as="sourcePoint" /><mxPoint x="368.0" y="1239.0" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="c84" value="&lt;b&gt;O que mudou em relação ao primeiro desenho&lt;/b&gt;&lt;br&gt;• O buzzer foi para a esquerda e o LED, para a direita. O som sai por 4 furos de 2 por 2, e não por 9, que ficariam grandes e exagerados.&lt;br&gt;• O LED sai pela tampa num furo de 5 mm, puxado por 4 jumpers macho-fêmea, com os resistores na protoboard. O furo e a etiqueta LED ainda não foram feitos.&lt;br&gt;• O ESP32 não tem placa de expansão: fica deitado no fundo, com o USB-C para a direita, preso por 4 parafusos M2,5. As arruelas, 4 no lado do USB-C e 2 no outro, erguem esse lado para o plugue do cabo encaixar. A placa não leva fita.&lt;br&gt;• A caixa fica na mesa por enquanto. Na parede, em 27/10 (data provisória), o fundo ganha calços de papelão nas quinas de fora, com a fita dupla-face neles, por causa das porcas e das pontas dos parafusos.&lt;br&gt;• A leitura do crachá pela tampa funcionou em 05/10; o teste completo com a caixa fechada (#33) foi feito em 06/10." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="1330.0" width="740.0" height="176.0" as="geometry" /></mxCell>
<mxCell id="c85" value="&lt;b&gt;Medidas&lt;/b&gt;&lt;br&gt;• Caixa de tênis, medida pelo Caio em 30/09: 33 × 20 × 12 cm por dentro (largura, altura e profundidade, como fica na parede) e 35,3 × 21,7 × 12,6 cm por fora; aba de 4,5 cm.&lt;br&gt;• Protoboard: 16,6 × 5,5 × 1,0 cm, medida em 22/09.&lt;br&gt;• Leitor (cerca de 6 × 4 cm) e placa do ESP32: aproximadas, medir com régua.&lt;br&gt;• Etiquetas na caixa: Encoste o crachá aqui, LED, Buzzer, ESP32 e Energia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="1514.0" width="740.0" height="110.0" as="geometry" /></mxCell>
</root></mxGraphModel></diagram></mxfile>