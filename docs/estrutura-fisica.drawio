<mxCell id="c2" value="Caixa de sapato pequena, ou outra caixa de papelão com tampa de encaixe, presa na parede ao lado da porta. Medidas aproximadas: conferir com a caixa que o grupo tiver." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="40.0" y="58.0" width="1300.0" height="20.0" as="geometry" /></mxCell>
