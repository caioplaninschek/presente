<mxCell id="c73" value="ESP32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;fontStyle=1;align=right;" vertex="1" parent="1"><mxGeometry x="317.0" y="1056.0" width="60.0" height="20.0" as="geometry" /></mxCell>
<mxCell id="c74" value="dobradiça: a tampa fecha pelo próprio peso" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#40606F;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="10.0" y="944.0" width="190.0" height="44.0" as="geometry" /></mxCell>
